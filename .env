# ShortStay secrets. Never commit this file.
# Get a test key from https://dashboard.paystack.co/#/settings/developers (toggle to Test mode).

# Your Paystack SECRET test key. Starts with sk_test_. Leave empty to run in demo payment mode.
PAYSTACK_SECRET_KEY=

# The password you use to open the host pages at /host.
HOST_PASSWORD=shortstay-host

# Where this site runs. Paystack redirects guests back here after payment.
SITE_URL=http://localhost:4321

# Stretch goal only (not used yet).
RESEND_API_KEY=
