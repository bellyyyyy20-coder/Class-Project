---
// The landing page at /.
//
// Everything here is rendered on the server. There is no JavaScript on this
// page at all: the FAQ uses plain <details> elements and the contact form
// posts to /contact, which sends the email.
import Layout from '../layouts/Layout.astro';
import ApartmentCard from '../components/ApartmentCard.astro';
import { getApartments } from '../lib/db.ts';
import { ROOM_TIERS } from '../lib/tiers.ts';
import { formatNaira } from '../lib/money.ts';
import { env } from '../lib/env.ts';
import { whatsappUrl } from '../lib/whatsapp.ts';

const apartments = await getApartments();

/* ---- Tier cards ---------------------------------------------------------
   For each of the five tiers we find the cheapest apartment in it, straight
   from the database, so "from ₦..." is always correct. */
const cheapestByTier = new Map<string, number>();
for (const apartment of apartments) {
  const current = cheapestByTier.get(apartment.tier);
  if (current === undefined || apartment.price_per_night < current) {
    cheapestByTier.set(apartment.tier, apartment.price_per_night);
  }
}
const tiers = ROOM_TIERS.map((tier) => ({
  ...tier,
  fromPrice: cheapestByTier.get(tier.name) ?? 0,
}));

// Three apartments to show off. If the database has fewer, we show what we have.
const featured = apartments.slice(0, 3);

/* ---- Contact details --------------------------------------------------- */
const hostEmail = env('HOST_EMAIL');
const chatUrl = whatsappUrl('Hello ShortStay, I would like to ask about a stay.');
// If no WhatsApp number is configured yet, the button falls back to email
// so it is never a dead link.
const contactButtonUrl = chatUrl || `mailto:${hostEmail}`;

/* ---- Form feedback (the contact route redirects back here) ------------- */
const contactState = Astro.url.searchParams.get('contact') ?? '';
---

<Layout
  title="Your stay, arranged directly"
  description="Thoughtful shortlet apartments in Lagos. Browse by room tier, book direct with the host and pay securely."
>
  <!-- 1. Hero ------------------------------------------------------------ -->
  <section class="hero">
    <img
      class="hero-image"
      src="/images/hero.jpg"
      width="1600"
      height="900"
      alt="Sunlit ShortStay living room with wide windows and soft cream furniture"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container hero-content">
      <p class="hero-eyebrow">Shortlet stays in Lagos</p>
      <h1>Your stay, arranged directly.</h1>
      <p class="hero-lead">
        Thoughtful apartments, a warmer welcome and a booking that takes minutes,
        straight with the host.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/apartments">Browse apartments</a>
        <a class="btn btn-gold" href="#contact">Contact us</a>
      </div>
    </div>
  </section>

  <!-- 2. Why book direct ------------------------------------------------- -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">A better way to stay</p>
      <h2>Why book direct</h2>
      <p class="section-lead">
        No agents, no middleman and no surprises. You speak to the person who
        actually looks after the apartment.
      </p>
      <div class="reasons">
        <article class="card reason">
          <span class="reason-number" aria-hidden="true">01</span>
          <h3>A real person, not a call centre</h3>
          <p>Ask questions before you book and get an answer from your host.</p>
        </article>
        <article class="card reason">
          <span class="reason-number" aria-hidden="true">02</span>
          <h3>Clear, honest pricing</h3>
          <p>See the full price for your dates before you pay. No hidden fees.</p>
        </article>
        <article class="card reason">
          <span class="reason-number" aria-hidden="true">03</span>
          <h3>Dates that are truly free</h3>
          <p>Booked nights are blocked, so the calendar you see is the real one.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 3. The five room tiers --------------------------------------------- -->
  <section class="section band">
    <div class="container">
      <p class="eyebrow">Find your fit</p>
      <h2>Five ways to stay</h2>
      <p class="section-lead">
        From a smart city studio to our Presidential Suite, every room is
        looked after by the same host.
      </p>
      <div class="tier-grid">
        {tiers.map((tier) => (
          <a class="tier" href={`/apartments?tier=${tier.slug}`}>
            <span class="tier-name">{tier.name}</span>
            <span class="tier-blurb">{tier.blurb}</span>
            {tier.fromPrice > 0 ? (
              <span class="tier-price">from {formatNaira(tier.fromPrice)}</span>
            ) : (
              <span class="tier-price">Ask us about availability</span>
            )}
            <span class="tier-link">View rooms &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Three featured apartments --------------------------------------- -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">A few guest favourites</p>
      <h2>Stay somewhere special</h2>
      <div class="apartment-grid">
        {featured.map((apartment) => <ApartmentCard apartment={apartment} />)}
      </div>
      <p class="center-link">
        <a class="btn btn-secondary" href="/apartments">Explore all apartments</a>
      </p>
    </div>
  </section>

  <!-- 5. How it works ----------------------------------------------------- -->
  <section class="section band">
    <div class="container">
      <p class="eyebrow">Simple from start to stay</p>
      <h2>How it works</h2>
      <div class="steps">
        <article class="card step">
          <span class="step-number" aria-hidden="true">1</span>
          <h3>Choose your apartment</h3>
          <p>Pick a room tier, then a home that suits your trip and your group.</p>
        </article>
        <article class="card step">
          <span class="step-number" aria-hidden="true">2</span>
          <h3>Select your dates</h3>
          <p>Unavailable nights are greyed out, and the total updates as you pick.</p>
        </article>
        <article class="card step">
          <span class="step-number" aria-hidden="true">3</span>
          <h3>Book and pay securely</h3>
          <p>Pay online through Paystack and get your booking reference at once.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 6. Guest reviews (sample placeholders) ------------------------------ -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">Kind words</p>
      <h2>Guest reviews</h2>
      <p class="sample-note">
        Please note: these are sample placeholders, not real guest reviews.
        Replace them with your own feedback before you share the site.
      </p>
      <div class="reviews">
        <blockquote class="card review">
          <p>"A lovely, peaceful place and such a smooth booking."</p>
          <cite>Sample guest &middot; placeholder review</cite>
        </blockquote>
        <blockquote class="card review">
          <p>"Everything was clear, comfortable and exactly as described."</p>
          <cite>Sample guest &middot; placeholder review</cite>
        </blockquote>
        <blockquote class="card review">
          <p>"The host was welcoming and quick to help with everything."</p>
          <cite>Sample guest &middot; placeholder review</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- 7. FAQ --------------------------------------------------------------- -->
  <section class="section band">
    <div class="container">
      <p class="eyebrow">Good to know</p>
      <h2>Frequently asked questions</h2>
      <div class="faq">
        <details>
          <summary>What time is check-in?</summary>
          <p>Check-in is from 2:00 PM. Check-out is by 11:00 AM, and because the
             check-out day is not a booked night, another guest can arrive the
             same afternoon.</p>
        </details>
        <details>
          <summary>What is the cancellation policy?</summary>
          <p>Tell the host as early as you can and we will do our best to move or
             cancel your stay. For this demo site no real money is taken, so
             cancellations are handled by the host directly.</p>
        </details>
        <details>
          <summary>What are the house rules?</summary>
          <p>Rules differ slightly by apartment: no smoking indoors and no parties
             anywhere. You will see the full list for your room on its page before
             you book.</p>
        </details>
        <details>
          <summary>How do I pay?</summary>
          <p>You pay online through Paystack, in Naira. Your booking is confirmed
             only after the payment is verified, and you get a reference code to
             keep.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- 8. Contact ----------------------------------------------------------- -->
  <section class="section" id="contact">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">We are here to help</p>
        <h2>Let us plan your stay.</h2>
        <p>
          Questions about dates, a particular apartment or a booking you have
          already made? Message us and the host will reply personally.
        </p>

        <a class="btn btn-primary" href={contactButtonUrl} target="_blank" rel="noreferrer">
          Chat on WhatsApp
        </a>

        {hostEmail && (
          <p class="contact-email">
            Or email <a href={`mailto:${hostEmail}`}>{hostEmail}</a>
          </p>
        )}
      </div>

      <form class="card contact-form" action="/contact" method="post">
        <h3>Send a message</h3>

        {contactState === 'sent' && (
          <p class="notice notice-success" role="status">
            Thank you - your message is on its way. We usually reply within a few
            hours.
          </p>
        )}
        {contactState === 'invalid' && (
          <p class="notice notice-error" role="alert">
            Please check your name, email, phone number and message, then try again.
          </p>
        )}
        {contactState === 'error' && (
          <p class="notice notice-error" role="alert">
            We could not send your message just now. Please use WhatsApp or email
            us directly.
          </p>
        )}

        <div class="field">
          <label for="contact-name">Your name</label>
          <input id="contact-name" name="name" autocomplete="name" maxlength="100" required />
        </div>
        <div class="field">
          <label for="contact-email">Email</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required />
        </div>
        <div class="field">
          <label for="contact-phone">Phone</label>
          <input id="contact-phone" name="phone" type="tel" autocomplete="tel" maxlength="30" required />
        </div>
        <div class="field">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" name="message" rows="4" maxlength="3000" required></textarea>
        </div>

        <!-- Honeypot: hidden from people, tempting to bots. -->
        <div class="honeypot" aria-hidden="true">
          <label for="contact-website">Leave this field empty</label>
          <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button class="btn btn-primary btn-block" type="submit">Send message</button>
      </form>
    </div>
  </section>
</Layout>

<style>
  /* ---------------------------------------------------------------- Hero */
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 520px;
    overflow: hidden;
    color: #ffffff;
  }

  .hero-image,
  .hero-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A blue wash so white text always has enough contrast over the photo. */
  .hero-shade {
    background: linear-gradient(
      100deg,
      rgba(13, 27, 61, 0.9) 0%,
      rgba(13, 27, 61, 0.7) 45%,
      rgba(13, 27, 61, 0.35) 100%
    );
  }

  .hero-content {
    position: relative;
    padding-top: var(--space-9);
    padding-bottom: var(--space-9);
  }

  .hero-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #f1d48b; /* light gold, readable on the dark photo */
    margin-bottom: var(--space-3);
  }

  .hero h1 {
    color: #ffffff;
    max-width: 16ch;
    margin-bottom: var(--space-4);
  }

  .hero-lead {
    max-width: 46ch;
    font-size: 1.0625rem;
    margin-bottom: var(--space-5);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* The single gold action on the page, lightened for the dark hero. */
  .hero .btn-gold {
    color: #f1d48b;
  }

  .hero .btn-gold:hover {
    background: var(--color-accent);
    color: var(--color-primary-dark);
  }

  @media (min-width: 768px) {
    .hero {
      min-height: 620px;
    }
  }

  /* ------------------------------------------------------- Section basics */
  .section-lead {
    max-width: 60ch;
    color: var(--color-muted);
    margin-bottom: var(--space-6);
  }

  /* A white band between two cream sections, to separate the story. */
  .band {
    background: var(--color-card);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  /* ---------------------------------------------------- Why book direct */
  .reasons,
  .steps,
  .reviews {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  .reason,
  .step,
  .review {
    padding: var(--space-5);
  }

  .reason h3,
  .step h3 {
    margin-bottom: var(--space-2);
  }

  .reason p,
  .step p,
  .review p {
    margin: 0;
    color: var(--color-muted);
  }

  .reason-number,
  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-bottom: var(--space-4);
    border-radius: 50%;
    border: 1px solid var(--color-border);
    color: var(--color-accent-text);
    font-weight: 600;
  }

  /* ----------------------------------------------------------- Tier grid */
  .tier-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .tier {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .tier:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .tier-name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .tier-blurb {
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .tier-price {
    margin-top: var(--space-2);
    font-weight: 600;
    color: var(--color-accent-text);
  }

  .tier-link {
    margin-top: var(--space-2);
    font-weight: 500;
    color: var(--color-primary);
  }

  /* ------------------------------------------------------- Featured row */
  .center-link {
    margin-top: var(--space-6);
    text-align: center;
  }

  /* ---------------------------------------------------------- Reviews */
  .sample-note {
    max-width: 60ch;
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-6);
    border-left: 2px solid var(--color-accent);
    background: var(--color-card);
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .review p {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.375rem;
    line-height: 1.4;
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .review cite {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-style: normal;
    color: var(--color-muted);
  }

  /* -------------------------------------------------------------- FAQ */
  .faq {
    max-width: 760px;
  }

  .faq details {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .faq summary {
    font-weight: 600;
    color: var(--color-primary);
    cursor: pointer;
  }

  .faq details p {
    margin: var(--space-3) 0 0;
    color: var(--color-muted);
  }

  /* ---------------------------------------------------------- Contact */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  .contact-email {
    margin-top: var(--space-4);
    color: var(--color-muted);
  }

  .contact-form {
    padding: var(--space-5);
  }

  .contact-form h3 {
    margin-bottom: var(--space-4);
  }

  /* ------------------------------------------------ Larger screens */
  @media (min-width: 640px) {
    .reasons,
    .steps,
    .reviews {
      grid-template-columns: repeat(2, 1fr);
    }

    .tier-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .reasons,
    .steps,
    .reviews {
      grid-template-columns: repeat(3, 1fr);
    }

    .tier-grid {
      grid-template-columns: repeat(5, 1fr);
    }

    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
