---
import { whatsappUrl } from '../lib/whatsapp.ts';

// The "Contact us" button opens WhatsApp with a message already typed. If no
// number is set in .env yet, it falls back to the contact section on the home
// page, so the button is never a dead link.
const chatUrl = whatsappUrl() || '/#contact';
const opensWhatsApp = chatUrl.startsWith('https://');

// Thin gold line under the header, a serif logo with a small gold detail,
// and only a few links (style guide: "few links only").
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="ShortStay home">
      ShortStay<span class="logo-dot" aria-hidden="true"></span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <a href="/apartments">Apartments</a>
      <a
        class="btn btn-primary header-contact"
        href={chatUrl}
        target={opensWhatsApp ? '_blank' : undefined}
        rel={opensWhatsApp ? 'noreferrer' : undefined}
      >
        Contact us
      </a>
      <a href="/host" class="host-link">Host</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-card);
    border-bottom: 1px solid var(--color-accent);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-primary);
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
  }

  .logo:hover {
    color: var(--color-primary-dark);
  }

  /* The small gold detail next to the wordmark */
  .logo-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    display: inline-block;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .site-nav a {
    color: var(--color-text);
    font-weight: 500;
  }

  .site-nav a:hover {
    color: var(--color-primary);
  }
  .site-nav .header-contact { color: white; padding: 9px 16px; }
  .site-nav .header-contact:hover { color: white; }
  @media (max-width: 420px) { .site-nav { gap: var(--space-3); } .site-nav .host-link { display: none; } }
</style>
