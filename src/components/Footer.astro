---
// Simple footer with a thin gold top line.
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-tagline">Book direct. No middleman.</p>
    <p class="footer-note small muted">ShortStay · Payments handled securely by Paystack (test mode)</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-accent);
    background: var(--color-card);
    margin-top: var(--space-8);
  }

  .footer-inner {
    padding: var(--space-6) var(--space-4);
    text-align: center;
  }

  .footer-tagline {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.25rem;
    color: var(--color-primary);
    margin: 0 0 var(--space-2);
  }

  .footer-note {
    margin: 0;
  }
</style>
