# Copy this file to .env and fill in the values. The real .env is never committed.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
PAYSTACK_SECRET_KEY=sk_test_xxx
HOST_PASSWORD=choose-something
SITE_URL=http://localhost:4321

# WhatsApp number for the "Contact us" buttons. International form, digits only.
PUBLIC_WHATSAPP_NUMBER=2348012345678

# The host's inbox: where contact-form enquiries are sent.
HOST_EMAIL=hello@example.com

# Resend (https://resend.com) sends the contact-form email.
# Put your own Resend sending key here; this example value is only a placeholder.
RESEND_API_KEY=re_xxxxxxxx
# While testing you can use the shared test sender below, but Resend will only
# deliver it to the address the Resend account was created with.
# For real use, verify your own domain and put an address on it here.
FROM_EMAIL=onboarding@resend.dev
